rules_version = '2';

// PROTOTYPE RULES — open read/write to anyone who knows a campaign ID.
// This is fine for a private home game where the campaign ID is a
// long, unguessable string that only your table has. It is NOT safe
// for anything you'd mind a stranger poking at.
//
// See the "Hardening later" section of README.md for how to tighten
// this once the prototype is working.

service cloud.firestore {
  match /databases/{database}/documents {
    match /campaigns/{campaignId}/characters/{characterId} {
      allow read, write: if true;
    }
    // The crew's ships (shared hold and chest) and campaign settings
    // (which ship is the active one).
    match /campaigns/{campaignId}/ships/{shipId} {
      allow read, write: if true;
    }
    match /campaigns/{campaignId}/settings/{docId} {
      allow read, write: if true;
    }
    // The admin page lists every campaign with a collection-group query
    // over all "characters" collections, which needs its own rule.
    match /{path=**}/characters/{characterId} {
      allow read: if true;
    }
    // Same for the ships and campaign settings, so admin backups, renames
    // and deletes include them.
    match /{path=**}/ships/{shipId} {
      allow read: if true;
    }
    match /{path=**}/settings/{docId} {
      allow read: if true;
    }
  }
}
